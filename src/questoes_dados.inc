{4, LR"CRONOS(F4-20)CRONOS", LR"CRONOS(De 13 tubos de refrigeração, 4 serão inspecionados ao mesmo tempo. Quantas seleções diferentes são possíveis?)CRONOS", LR"CRONOS(715)CRONOS", LR"CRONOS(C(13,4) = 13!/(4!·9!) = 715.)CRONOS"},
{5, LR"CRONOS(F5-11)CRONOS", LR"CRONOS(Sala da Cápsula: 6 sobreviventes entram em fila, mas Marta deve ser SEMPRE a primeira. De quantas formas a fila pode ser formada?)CRONOS", LR"CRONOS(120)CRONOS", LR"CRONOS(Marta está fixa na 1ª posição; as outras 5 pessoas se permutam: 5! = 120.)CRONOS"},
{5, LR"CRONOS(F5-12)CRONOS", LR"CRONOS(Quatro homens e três mulheres formam uma fila de 7 pessoas, alternando sexos (começando e terminando por homem: H M H M H M H). De quantas formas a fila pode ser organizada?)CRONOS", LR"CRONOS(144)CRONOS", LR"CRONOS(Homens nas posições 1, 3, 5 e 7: 4! = 24. Mulheres nas posições 2, 4 e 6: 3! = 6. Total 24·6 = 144.)CRONOS"},
{5, LR"CRONOS(F5-13)CRONOS", LR"CRONOS(Quantos números PARES de 3 algarismos distintos existem? (Use os algarismos de 0 a 9; o primeiro não pode ser zero.))CRONOS", LR"CRONOS(328)CRONOS", LR"CRONOS(Terminando em 0: 9·8 = 72. Terminando em 2, 4, 6 ou 8 (4 opções): centena tem 8 opções (sem o 0 e sem a unidade) e dezena 8: 4·8·8 = 256. Total 72 + 256 = 328.)CRONOS"},
{5, LR"CRONOS(F5-14)CRONOS", LR"CRONOS(Uma equipe de 4 pessoas será escolhida entre 5 homens e 5 mulheres, com a exigência de ter PELO MENOS 2 mulheres. Quantas equipes são possíveis?)CRONOS", LR"CRONOS(155)CRONOS", LR"CRONOS(Total: C(10,4) = 210. Sem mulheres: C(5,4) = 5. Com exatamente 1 mulher: 5·C(5,3) = 50. Resposta: 210 − 5 − 50 = 155.)CRONOS"},
{5, LR"CRONOS(F5-15)CRONOS", LR"CRONOS(Sete pessoas entram em fila na cápsula, mas Léo e Nina NÃO podem ficar lado a lado. Quantas filas são possíveis?)CRONOS", LR"CRONOS(3600)CRONOS", LR"CRONOS(Total: 7! = 5040. Com Léo e Nina juntos: 6!·2! = 1440. Resposta: 5040 − 1440 = 3600.)CRONOS"},

{5, LR"CRONOS(F5-17)CRONOS", LR"CRONOS(Quantos números de 4 algarismos DISTINTOS começam pelo algarismo 7?)CRONOS", LR"CRONOS(504)CRONOS", LR"CRONOS(O 7 fica fixo na primeira posição. Para as 3 posições restantes sobram 9 algarismos: A(9,3) = 9·8·7 = 504.)CRONOS"},
{5, LR"CRONOS(F5-18)CRONOS", LR"CRONOS(Uma comissão de 3 pessoas será escolhida entre 6 homens e 5 mulheres, com PELO MENOS 1 mulher. Quantas comissões são possíveis?)CRONOS", LR"CRONOS(145)CRONOS", LR"CRONOS(Total: C(11,3) = 165. Sem mulheres: C(6,3) = 20. Resposta: 165 − 20 = 145.)CRONOS"},
{5, LR"CRONOS(F5-19)CRONOS", LR"CRONOS(Dos anagramas da palavra BUNKER (6 letras distintas), quantos TERMINAM em consoante?)CRONOS", LR"CRONOS(480)CRONOS", LR"CRONOS(Consoantes: B, N, K, R (4 opções para a última posição). As outras 5 letras se permutam: 5! = 120. Total 4·120 = 480.)CRONOS"},
{5, LR"CRONOS(F5-20)CRONOS", LR"CRONOS(Quantos números de 3 algarismos DISTINTOS e MENORES que 400 existem? (Algarismos de 0 a 9; o primeiro não pode ser zero.))CRONOS", LR"CRONOS(216)CRONOS", LR"CRONOS(Primeiro algarismo: 1, 2 ou 3 (3 opções). Depois 9 opções e 8 opções: 3·9·8 = 216.)CRONOS"},
